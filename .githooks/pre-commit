#!/bin/sh
# Block direct commits to main, and run the harness on every commit.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Blocked: do not commit to main. Create a branch and open a PR."
  exit 1
fi
if command -v python >/dev/null 2>&1; then python scripts/harness_check.py; else python3 scripts/harness_check.py; fi
